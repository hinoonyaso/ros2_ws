<?xml version="1.0"?>
<robot name="two_axis_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================= -->
  <!-- Properties -->
  <!-- ========================= -->
  <xacro:property name="base_height" value="0.08"/>
  <xacro:property name="link1_length" value="0.6"/>
  <xacro:property name="link2_length" value="0.45"/>

  <!-- FreeCAD에서 mm 단위로 export한 STL을 m 단위로 줄이기 위한 scale -->
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- ========================= -->
  <!-- Materials -->
  <!-- ========================= -->
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.1 0.3 0.9 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.1 0.8 0.3 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.9 0.1 0.1 1.0"/>
  </material>

  <!-- ========================= -->
  <!-- base_link -->
  <!-- ========================= -->
  <link name="base_link">
    <visual>
      <!-- FreeCAD에서 base의 원점을 바닥 중심에 맞췄다고 가정 -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://two_axis_arm_description/meshes/base.stl"
              scale="${mesh_scale}"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- ========================= -->
  <!-- joint1 -->
  <!-- ========================= -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>

    <!-- base 위쪽에 joint1 배치 -->
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>

    <!-- 수직형 로봇팔: y축 기준 회전 -->
    <axis xyz="0 1 0"/>

    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <!-- ========================= -->
  <!-- link1 -->
  <!-- ========================= -->
  <link name="link1">
    <visual>
      <!-- FreeCAD에서 link1 원점을 joint1 위치, 즉 아래쪽 시작점에 맞췄다고 가정 -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://two_axis_arm_description/meshes/link1.stl"
              scale="${mesh_scale}"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- ========================= -->
  <!-- joint2 -->
  <!-- ========================= -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>

    <!-- link1 위쪽 끝에 joint2 배치 -->
    <origin xyz="0 0 ${link1_length}" rpy="0 0 0"/>

    <!-- 수직형 로봇팔: y축 기준 회전 -->
    <axis xyz="0 1 0"/>

    <limit lower="-2.0" upper="2.0" effort="10" velocity="1.0"/>
  </joint>

  <!-- ========================= -->
  <!-- link2 -->
  <!-- ========================= -->
  <link name="link2">
    <visual>
      <!-- FreeCAD에서 link2 원점을 joint2 위치, 즉 아래쪽 시작점에 맞췄다고 가정 -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://two_axis_arm_description/meshes/link2.stl"
              scale="${mesh_scale}"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <!-- ========================= -->
  <!-- tool_joint -->
  <!-- ========================= -->
  <joint name="tool_joint" type="fixed">
    <parent link="link2"/>
    <child link="tool_link"/>

    <!-- link2 위쪽 끝에 tool_link 배치 -->
    <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- tool_link -->
  <!-- ========================= -->
  <link name="tool_link">
    <visual>
      <!-- FreeCAD에서 tool 원점을 link2 끝에 붙는 위치로 맞췄다고 가정 -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://two_axis_arm_description/meshes/tool.stl"
              scale="${mesh_scale}"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

</robot>